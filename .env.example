# Salin file ini menjadi .env (jangan di-commit) lalu isi nilainya.
# SECRET_KEY: string acak panjang. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang
# Supabase: Project Settings > Database > Connection string > pilih 'Session pooler' (IPv4, dipakai juga dari Google Colab).
# Format: postgresql+psycopg2://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Opsional, hanya untuk tes: database terpisah supaya tes tidak menyentuh data utama.
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:@127.0.0.1:5432/cnn_jalan_test

# 1 = mode debug (hanya untuk development lokal), 0 = mati
FLASK_DEBUG=0
