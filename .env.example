# Salin file ini menjadi .env (jangan di-commit) lalu isi nilainya.
# SECRET_KEY: string acak panjang. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang
DATABASE_URL=mysql+pymysql://root:PASSWORD_MYSQL@localhost/db_cnn_jalan

# 1 = mode debug (hanya untuk development lokal), 0 = mati
FLASK_DEBUG=0
