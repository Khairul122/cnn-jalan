# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env yang sudah terisi.

# Kunci penanda tangan session. Generate nilai acak, misalnya:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL. Format URL: mysql+pymysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Driver PyMySQL sudah ada di requirements.txt (tidak perlu psycopg2/PostgreSQL).
# Contoh lokal:
#   DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cnn_jalan
DATABASE_URL=
