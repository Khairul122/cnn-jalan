# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Trained models (large binary files)
*.keras
app/static/models/

# Training logs
app/static/logs/

# User uploads & image datasets
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/uploads/foto/*
!app/static/uploads/foto/.gitkeep
app/static/uploads/preprocessed/*
!app/static/uploads/preprocessed/.gitkeep
app/static/uploads/augmented/*
!app/static/uploads/augmented/.gitkeep

# Dataset directory & image binary files
data/*
!data/.gitkeep
*.png
*.jpg
*.jpeg
*.webp
*.bmp
!app/static/logo/*.png
!app/static/logo/*.jpg
!app/static/logo/*.svg


# Cadangan sebelum migrasi kelas
backup_*/

# Superpowers execution artifacts
.superpowers/
